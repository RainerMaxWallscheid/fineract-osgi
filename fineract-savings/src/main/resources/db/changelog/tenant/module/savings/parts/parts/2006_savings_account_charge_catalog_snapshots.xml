<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!-- Charge OSGi Step 8 residual: SavingsAccountCharge stores catalog chargeId + snapshots; no JPA association to Charge. -->
    <changeSet author="fineract" id="savings-account-charge-catalog-snapshots-1">
        <addColumn tableName="m_savings_account_charge">
            <column name="charge_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
            <column name="is_free_withdrawal" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="is_payment_type" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="free_withdrawal_charge_frequency" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="restart_frequency" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="restart_frequency_enum" type="INT">
                <constraints nullable="true"/>
            </column>
            <column name="payment_type_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="savings-account-charge-catalog-snapshots-2-postgresql" context="postgresql">
        <sql>
            UPDATE m_savings_account_charge sc
            SET charge_name = c.name,
                currency_code = c.currency_code,
                is_free_withdrawal = COALESCE(c.is_free_withdrawal, false),
                is_payment_type = COALESCE(c.is_payment_type, false),
                free_withdrawal_charge_frequency = c.free_withdrawal_charge_frequency,
                restart_frequency = c.restart_frequency,
                restart_frequency_enum = c.restart_frequency_enum,
                payment_type_name = pt.value
            FROM m_charge c
            LEFT JOIN m_payment_type pt ON pt.id = c.payment_type_id
            WHERE sc.charge_id = c.id
        </sql>
    </changeSet>

    <changeSet author="fineract" id="savings-account-charge-catalog-snapshots-2-mysql" context="mysql">
        <sql>
            UPDATE m_savings_account_charge sc
                JOIN m_charge c ON sc.charge_id = c.id
                LEFT JOIN m_payment_type pt ON pt.id = c.payment_type_id
            SET sc.charge_name = c.name,
                sc.currency_code = c.currency_code,
                sc.is_free_withdrawal = COALESCE(c.is_free_withdrawal, 0),
                sc.is_payment_type = COALESCE(c.is_payment_type, 0),
                sc.free_withdrawal_charge_frequency = c.free_withdrawal_charge_frequency,
                sc.restart_frequency = c.restart_frequency,
                sc.restart_frequency_enum = c.restart_frequency_enum,
                sc.payment_type_name = pt.value
        </sql>
    </changeSet>
</databaseChangeLog>
