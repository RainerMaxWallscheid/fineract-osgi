<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.1.xsd">
    <!-- Charge OSGi Step 8 residual: ClientCharge / ShareAccountCharge store catalog chargeId + snapshots. -->
    <changeSet author="fineract" id="client-charge-catalog-snapshots-1">
        <addColumn tableName="m_client_charge">
            <column name="charge_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
            <column name="income_or_liability_account_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="client-charge-catalog-snapshots-2-postgresql" context="postgresql">
        <sql>
            UPDATE m_client_charge cc
            SET charge_name = c.name,
                currency_code = c.currency_code,
                income_or_liability_account_id = c.income_or_liability_account_id
            FROM m_charge c
            WHERE cc.charge_id = c.id
        </sql>
    </changeSet>

    <changeSet author="fineract" id="client-charge-catalog-snapshots-2-mysql" context="mysql">
        <sql>
            UPDATE m_client_charge cc
                JOIN m_charge c ON cc.charge_id = c.id
            SET cc.charge_name = c.name,
                cc.currency_code = c.currency_code,
                cc.income_or_liability_account_id = c.income_or_liability_account_id
        </sql>
    </changeSet>

    <changeSet author="fineract" id="share-account-charge-catalog-snapshots-1">
        <addColumn tableName="m_share_account_charge">
            <column name="charge_name" type="VARCHAR(100)">
                <constraints nullable="true"/>
            </column>
            <column name="currency_code" type="VARCHAR(3)">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

    <changeSet author="fineract" id="share-account-charge-catalog-snapshots-2-postgresql" context="postgresql">
        <sql>
            UPDATE m_share_account_charge sc
            SET charge_name = c.name,
                currency_code = c.currency_code
            FROM m_charge c
            WHERE sc.charge_id = c.id
        </sql>
    </changeSet>

    <changeSet author="fineract" id="share-account-charge-catalog-snapshots-2-mysql" context="mysql">
        <sql>
            UPDATE m_share_account_charge sc
                JOIN m_charge c ON sc.charge_id = c.id
            SET sc.charge_name = c.name,
                sc.currency_code = c.currency_code
        </sql>
    </changeSet>
</databaseChangeLog>
